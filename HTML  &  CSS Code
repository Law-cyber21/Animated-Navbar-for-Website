<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Animated Navbar</title>
    <style>
        body {
            background: linear-gradient( 120deg, rgba(138, 80, 255, 0.45), rgba(60, 120, 255, 0.40) 50%, rgba(255, 255, 255, 0.35));
        }
        
        .navbar {
            position: fixed;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 1000px;
            box-sizing: border-box;
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-radius: 122px;
            background: linear-gradient( 120deg, rgba(138, 80, 255, 0.45), rgba(60, 120, 255, 0.40) 50%, rgba(255, 255, 255, 0.35));
            /* Effetto vetro */
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px rgba(80, 60, 200, 0.3);
        }
        
        input {
            border-radius: 10px;
            padding: 8px;
            border: none;
            outline: none;
            color: whitesmoke;
            width: 200px;
            background: linear-gradient(120deg, rgba(138, 80, 255, 0.45), rgba(60, 120, 255, 0.40) 50%, rgba(255, 255, 255, 0.35));
            transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        
        input:hover,
        input:focus {
            width: 220px;
            box-shadow: 0 0 12px rgba(138, 80, 255, 0.5);
        }
        
        .logo {
            font-size: 20px;
            font-weight: bold;
            color: white;
            text-decoration: none;
            letter-spacing: 1px;
        }
        
        .nav-links {
            display: flex;
            gap: 8px;
            margin: 0;
            padding: 0;
            list-style: none;
        }
        
        .nav-links a {
            display: block;
            padding: 8px 16px;
            color: white;
            text-decoration: none;
            font-size: 15px;
            border-radius: 999px;
            transition: background 0.25s, transform 0.25s;
        }
        
        .nav-links a:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <a href="#" class="logo">MyLogo</a>
        <input type="text" placeholder="Search..">
        <ul class="nav-links">
            <li><a href="#">Home</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>
</body>

</html>
